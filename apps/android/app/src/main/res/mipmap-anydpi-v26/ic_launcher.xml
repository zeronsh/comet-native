<?xml version="1.0" encoding="utf-8"?>
<!-- minSdk is 26, so the adaptive icon covers every supported launcher and no
     density-bucket PNG fallbacks are needed. `monochrome` supplies the themed
     icon Android 13+ tints to the user's wallpaper palette. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/zeron_bg" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
